---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">CarMatch India</h1>
      <p class="text-xl text-gray-600">Find the perfect car for your needs and budget</p>
    </header>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8">
      <h2 class="text-2xl font-semibold mb-4">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center p-4">
          <div class="text-3xl mb-2">1️⃣</div>
          <h3 class="font-medium mb-1">Tell Us Your Needs</h3>
          <p class="text-sm text-gray-500">Select your budget, preferred body type, fuel type, and must-have features</p>
        </div>
        <div class="text-center p-4">
          <div class="text-3xl mb-2">2️⃣</div>
          <h3 class="font-medium mb-1">Set Your Priorities</h3>
          <p class="text-sm text-gray-500">Choose what matters most — safety, reliability, features, or value for money</p>
        </div>
        <div class="text-center p-4">
          <div class="text-3xl mb-2">3️⃣</div>
          <h3 class="font-medium mb-1">Get Matched</h3>
          <p class="text-sm text-gray-500">Our engine scores every car against your preferences and shows your top matches</p>
        </div>
      </div>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8">
      <h2 class="text-2xl font-semibold mb-4">Coming Soon</h2>
      <p class="text-gray-600">The recommendation engine is being built. In the meantime, check out our car database and brand pages.</p>
    </section>

    <footer class="text-center text-sm text-gray-400 mt-12">
      <p>CarMatch India — Data sourced from manufacturer specifications and Bharat NCAP safety ratings.</p>
    </footer>
  </main>
</Layout>
